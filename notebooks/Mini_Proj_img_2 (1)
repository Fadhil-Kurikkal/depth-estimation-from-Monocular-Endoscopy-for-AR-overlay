        "#Converting raw depth into millimeters\n",
        "depth_mm = depth_raw.astype(np.float32) * (100.0 / 65535.0)\n",
        "\n",
        "# Create a valid-pixel mask\n",
        "valid_mask = depth_raw > 0\n",
        "\n",
        "# Print converted depth information\n",
        "print(\"Converted Depth Information\")\n",
        "print(\"Data type:\", depth_mm.dtype)\n",
        "print(\"Minimum:\", depth_mm[valid_mask].min(), \"mm\")\n",
        "print(\"Maximum:\", depth_mm[valid_mask].max(), \"mm\")\n",
        "print(\"Mean:\", depth_mm[valid_mask].mean(), \"mm\")\n",
        "print(\"Valid pixels:\", valid_mask.sum())\n",
        "print(\"Invalid pixels:\", (~valid_mask).sum())\n",
        "\n",
        "# Visualize converted depth\n",
        "plt.figure(figsize=(12, 5))\n",
        "\n",
        "plt.subplot(1, 2, 1)\n",
        "plt.imshow(depth_mm, cmap=\"viridis\")\n",
        "plt.title(\"Depth in Millimeters\")\n",
        "plt.colorbar(label=\"Depth (mm)\")\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.subplot(1, 2, 2)\n",
        "plt.imshow(valid_mask, cmap=\"gray\")\n",
        "plt.title(\"Valid Depth Pixel Mask\")\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.tight_layout()\n",
