        "print(f\"RMSE: {rmse:.4f} mm\")\n",
        "print(f\"Delta 1: {delta1:.4f} ({delta1*100:.2f}%)\")\n",
        "print(f\"Delta 2: {delta2:.4f} ({delta2*100:.2f}%)\")\n",
