        "#Calculate test metrics\n",
        "import math\n",
        "\n",
        "model.eval()\n",
        "\n",
        "abs_rel_sum = 0.0\n",
        "squared_error_sum = 0.0\n",
        "\n",
        "delta1_count = 0\n",
        "delta2_count = 0\n",
        "delta3_count = 0\n",
        "\n",
        "total_valid_pixels = 0\n",
        "\n",
        "with torch.no_grad():\n",
        "    for batch in test_loader:\n",
        "\n",
        "        rgb = batch[\"rgb\"].to(DEVICE)\n",
        "        depth = batch[\"depth\"].to(DEVICE)\n",
        "        mask = batch[\"mask\"].to(DEVICE)\n",
        "\n",
        "        prediction = model(rgb)\n",
        "\n",
        "        # Convert normalized depth to millimeters\n",
        "        prediction_mm = prediction * 100.0\n",
        "        target_mm = depth * 100.0\n",
        "\n",
        "        # Select valid pixels only\n",
        "        valid = mask.bool()\n",
        "\n",
        "        pred = prediction_mm[valid].clamp(min=1e-6)\n",
        "        target = target_mm[valid].clamp(min=1e-6)\n",
        "\n",
        "        # Absolute relative error\n",
        "        abs_rel_sum += (torch.abs(pred - target) / target).sum().item()\n",
        "\n",
        "        # Squared error for RMSE\n",
        "        squared_error_sum += ((pred - target) ** 2).sum().item()\n",
        "\n",
        "        # Accuracy thresholds\n",
        "        ratio = torch.maximum(pred / target, target / pred)\n",
        "\n",
        "        delta1_count += (ratio < 1.25).sum().item()\n",
        "        delta2_count += (ratio < 1.25**2).sum().item()\n",
        "        delta3_count += (ratio < 1.25**3).sum().item()\n",
        "\n",
        "        total_valid_pixels += target.numel()\n",
        "\n",
        "# Final metrics\n",
        "abs_rel = abs_rel_sum / total_valid_pixels\n",
        "rmse = math.sqrt(squared_error_sum / total_valid_pixels)\n",
        "\n",
        "delta1 = delta1_count / total_valid_pixels\n",
        "delta2 = delta2_count / total_valid_pixels\n",
        "delta3 = delta3_count / total_valid_pixels\n",
        "\n",
        "print(\"========== TEST RESULTS ==========\")\n",
