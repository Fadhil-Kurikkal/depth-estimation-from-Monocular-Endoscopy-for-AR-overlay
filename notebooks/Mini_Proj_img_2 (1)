        "#PyTorch Dataset class\n",
        "import os\n",
        "import numpy as np\n",
        "import cv2\n",
        "import torch\n",
        "\n",
        "from PIL import Image\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "\n",
        "\n",
        "class EndoscopyDepthDataset(Dataset):\n",
        "\n",
        "    def __init__(self, image_pairs, target_size=(320, 256)):\n",
        "\n",
        "        self.image_pairs = image_pairs\n",
        "        self.target_size = target_size\n",
        "\n",
        "        self.mean = np.array(\n",
        "            [0.485, 0.456, 0.406],\n",
        "            dtype=np.float32\n",
        "        )\n",
        "\n",
        "        self.std = np.array(\n",
        "            [0.229, 0.224, 0.225],\n",
        "            dtype=np.float32\n",
        "        )\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.image_pairs)\n",
        "\n",
        "    def __getitem__(self, index):\n",
        "\n",
        "        pair = self.image_pairs[index]\n",
        "\n",
        "        # Load RGB\n",
        "        rgb = np.array(\n",
        "            Image.open(pair[\"rgb\"]).convert(\"RGB\")\n",
        "        )\n",
        "\n",
        "        # Load raw depth\n",
        "        depth_raw = np.array(\n",
        "            Image.open(pair[\"depth\"])\n",
        "        )\n",
        "\n",
        "        # Convert depth to millimeters\n",
        "        depth_mm = depth_raw.astype(np.float32) * (\n",
        "            100.0 / 65535.0\n",
        "        )\n",
        "\n",
        "        # Create valid depth mask\n",
        "        valid_mask = depth_raw > 0\n",
        "\n",
        "        # Resize RGB\n",
        "        rgb = cv2.resize(\n",
        "            rgb,\n",
        "            self.target_size,\n",
        "            interpolation=cv2.INTER_AREA\n",
        "        )\n",
        "\n",
        "        # Resize depth and mask\n",
        "        depth_mm = cv2.resize(\n",
        "            depth_mm,\n",
        "            self.target_size,\n",
        "            interpolation=cv2.INTER_NEAREST\n",
        "        )\n",
        "\n",
        "        valid_mask = cv2.resize(\n",
        "            valid_mask.astype(np.uint8),\n",
        "            self.target_size,\n",
        "            interpolation=cv2.INTER_NEAREST\n",
        "        ).astype(bool)\n",
        "\n",
        "        # Normalize RGB\n",
        "        rgb = rgb.astype(np.float32) / 255.0\n",
        "        rgb = (rgb - self.mean) / self.std\n",
        "\n",
        "        # Normalize depth to 0-1\n",
        "        depth = depth_mm / 100.0\n",
        "        depth[~valid_mask] = 0.0\n",
        "\n",
        "        # Convert to PyTorch tensors\n",
        "        rgb = torch.from_numpy(\n",
        "            rgb.transpose(2, 0, 1).copy()\n",
        "        ).float()\n",
        "\n",
        "        depth = torch.from_numpy(\n",
        "            depth[np.newaxis, :, :].copy()\n",
        "        ).float()\n",
        "\n",
        "        mask = torch.from_numpy(\n",
        "            valid_mask[np.newaxis, :, :].copy()\n",
        "        ).bool()\n",
        "\n",
        "        return {\n",
        "            \"rgb\": rgb,\n",
        "            \"depth\": depth,\n",
        "            \"mask\": mask\n",
        "        }\n",
        "\n",
        "\n",
        "print(\"Dataset class created successfully!\")"
