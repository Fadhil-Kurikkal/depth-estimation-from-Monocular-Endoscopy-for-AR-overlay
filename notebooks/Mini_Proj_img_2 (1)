      "source": [
        "from PIL import Image\n",
        "\n",
        "def predict_endoscopy_depth(image):\n",
        "\n",
        "    # Check uploaded image\n",
        "    if image is None:\n",
        "        return None, None, None\n",
        "\n",
        "    # Convert image to RGB\n",
        "    image = np.array(image.convert(\"RGB\"))\n",
        "\n",
        "    # Resize to model input size\n",
        "    resized = cv2.resize(\n",
        "        image,\n",
        "        (320, 256),\n",
        "        interpolation=cv2.INTER_AREA\n",
        "    )\n",
        "\n",
        "    # ImageNet normalization\n",
        "    mean = np.array([0.485, 0.456, 0.406])\n",
        "    std = np.array([0.229, 0.224, 0.225])\n",
        "\n",
        "    normalized = resized.astype(np.float32) / 255.0\n",
        "    normalized = (normalized - mean) / std\n",
        "\n",
        "    # Convert to PyTorch tensor\n",
        "    input_tensor = torch.from_numpy(\n",
        "        normalized.transpose(2, 0, 1)\n",
        "    ).float().unsqueeze(0).to(DEVICE)\n",
        "\n",
        "    # Predict depth\n",
        "    model.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "        prediction = model(input_tensor)\n",
        "\n",
        "    # Convert predicted depth to millimeters\n",
        "    depth_mm = prediction[0, 0].cpu().numpy() * 100.0\n",
        "\n",
        "    # Create colorized depth map\n",
        "    depth_uint8 = np.clip(\n",
        "        depth_mm / 100.0 * 255,\n",
        "        0, 255\n",
        "    ).astype(np.uint8)\n",
        "\n",
        "    depth_colored = cv2.applyColorMap(\n",
        "        depth_uint8,\n",
        "        cv2.COLORMAP_JET\n",
        "    )\n",
        "\n",
        "    depth_colored = cv2.cvtColor(\n",
        "        depth_colored,\n",
        "        cv2.COLOR_BGR2RGB\n",
        "    )\n",
        "\n",
        "    # Blend original image and depth map\n",
        "    overlay = cv2.addWeighted(\n",
        "        resized,\n",
        "        0.6,\n",
        "        depth_colored,\n",
        "        0.4,\n",
        "        0\n",
        "    )\n",
        "\n",
        "    return resized, depth_colored, overlay"
